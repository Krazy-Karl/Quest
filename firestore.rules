rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Une « table » de jeu est un code secret : rooms/{code}/...
    // Il faut être connecté (anonymement) et connaître le code pour lire ou écrire.
    // Impossible de lister les tables existantes.
    match /rooms/{room}/{coll}/{rest=**} {
      allow read, write: if request.auth != null && coll != 'private';
    }
    // Notes privées du MJ : lisibles et modifiables uniquement par le navigateur qui les a écrites.
    match /rooms/{room}/private/{uid}/{rest=**} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
  }
}
